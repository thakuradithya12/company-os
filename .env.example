# Local development only. Never use these values in production.
COMPANY_OS_ENVIRONMENT=development
COMPANY_OS_LOG_LEVEL=INFO
COMPANY_OS_DATABASE_URL=postgresql+psycopg://company_os:company_os_dev_only@localhost:5432/company_os
# Required outside development; generate a cryptographically random value of at least 32 characters.
# COMPANY_OS_APP_SECRET_KEY=replace-with-a-random-secret-of-at-least-32-characters

POSTGRES_USER=company_os
POSTGRES_PASSWORD=company_os_dev_only
POSTGRES_DB=company_os
